NODE_ENV=development
PORT=3000

# Local PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=iron_culture_store
PGUSER=postgres
PGPASSWORD=replace_with_your_local_password

# Hosted PostgreSQL: configure privately in the hosting dashboard.
# Leave unset for local development.
# DATABASE_URL=

# Generate a unique secret of at least 64 characters.
SESSION_SECRET=replace_with_a_unique_random_secret_at_least_64_characters_long

# Product and brand images
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret

# Current integration supports sandbox only.
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=replace_with_sandbox_merchant_id
PAYFAST_MERCHANT_KEY=replace_with_sandbox_merchant_key
PAYFAST_PASSPHRASE=replace_with_sandbox_passphrase
PAYFAST_PUBLIC_BASE_URL=https://replace-with-your-public-host.example

# Current email integration supports local testing only.
EMAIL_MODE=test
EMAIL_SENDING_ENABLED=false
RESEND_API_KEY=replace_with_resend_api_key
EMAIL_FROM="Iron Culture Test <onboarding@resend.dev>"
EMAIL_TEST_RECIPIENT=replace_with_your_test_email@example.com

PASSWORD_RESET_PUBLIC_BASE_URL=https://replace-with-your-public-host.example
NEWSLETTER_PUBLIC_BASE_URL=https://replace-with-your-public-host.example

# Demo products remain hidden in production.
SHOW_DEMO_PRODUCTS=false