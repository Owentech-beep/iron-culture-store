<%- include("partials/head") %>
<%- include("partials/navbar") %>

<main id="main-content" class="section-space">
  <div class="container">
    <p class="eyebrow">STEP 2 — REVIEW</p>
    <h1 class="section-title">Review Your Order</h1>

    <% if (cart.items.some((item) => item.isDemo)) { %>
      <div class="demo-notice">
        This is a development test order containing demo products.
        It will not be charged or fulfilled.
      </div>
    <% } %>

    <div class="row g-4">
      <div class="col-lg-8">
        <section class="account-panel">
          <h2>Items</h2>

          <% cart.items.forEach((item) => { %>
            <div class="order-line">
              <div>
                <strong><%= item.name %></strong>
                <p class="text-muted-custom mb-0">
                  <%= item.variantName ?? item.flavour %> · Quantity <%= item.quantity %>
                </p>
              </div>

              <strong><%= formatMoney(item.lineTotalCents) %></strong>
            </div>
          <% }); %>

          <h2 class="mt-4">Deliver To</h2>

          <address>
            <%= draft.address.firstName %> <%= draft.address.lastName %><br>
            <%= draft.address.street %><br>
            <%= draft.address.suburb %>, <%= draft.address.city %><br>
            <%= draft.address.province %>, <%= draft.address.postalCode %><br>
            South Africa
          </address>

          <p>
            <%= draft.address.email %><br>
            <%= draft.address.phone %>
          </p>

          <a href="/checkout" class="btn btn-outline-brand">
            Edit Address
          </a>

          <a href="/cart" class="btn btn-outline-brand">
            Edit Cart
          </a>
        </section>
      </div>

      <div class="col-lg-4">
        <section class="cart-summary">
          <h2>Order Summary</h2>

          <dl class="cart-summary-lines">
            <div>
              <dt>Items</dt>
              <dd><%= formatMoney(cart.subtotalCents) %></dd>
            </div>

            <div>
              <dt>Delivery</dt>
              <dd>
                <%= shipping.deliveryCents === null
                  ? "Not available"
                  : shipping.deliveryCents === 0
                    ? "Free"
                    : formatMoney(shipping.deliveryCents) %>
              </dd>
            </div>

            <div>
              <dt>Total</dt>
              <dd>
                <%= shipping.totalCents === null
                  ? "Not available"
                  : formatMoney(shipping.totalCents) %>
              </dd>
            </div>
          </dl>

          <p class="text-muted-custom">
            Delivery is R99 below R750 after discounts.
            Orders of R750 or more after discounts qualify for free delivery.
          </p>

          <p class="text-muted-custom">
            Stock is checked and reserved when your payment attempt starts.
            Your order is marked paid after payment confirmation is received.
          </p>

          <% if (paymentMethods.length && shipping.totalCents !== null) { %>
            <form action="/checkout/orders" method="POST">
              <input
                type="hidden"
                name="_csrf"
                value="<%= csrfToken %>"
              >

              <input
                type="hidden"
                name="checkoutToken"
                value="<%= draft.token %>"
              >

              <fieldset class="mb-3">
                <legend class="h6">Payment method</legend>

                <% paymentMethods.forEach((method, index) => { %>
                  <div class="form-check mb-2">
                    <input
                      class="form-check-input"
                      type="radio"
                      name="paymentProvider"
                      id="paymentProvider-<%= method.id %>"
                      value="<%= method.id %>"
                      required
                      <% if (index === 0) { %>checked<% } %>
                    >

                    <label
                      class="form-check-label"
                      for="paymentProvider-<%= method.id %>"
                    >
                      <%= method.label %>
                    </label>
                  </div>
                <% }); %>
              </fieldset>

              <button class="btn btn-brand w-100" type="submit">
                Continue to Payment
              </button>
            </form>
          <% } else { %>
            <p class="notice-panel" role="status">
              Online payment is temporarily unavailable.
              Please contact the store for assistance.
            </p>
          <% } %>
        </section>
      </div>
    </div>
  </div>
</main>

<%- include("partials/footer") %>
<%- include("partials/scripts") %>