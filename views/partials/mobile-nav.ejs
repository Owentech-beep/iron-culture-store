<%
  const mobilePage =
    typeof activePage !== "undefined" ? activePage : "";

  const mobileUser =
    typeof currentUser !== "undefined" && currentUser;

  const mobileCartCount =
    typeof cartCount !== "undefined" ? Number(cartCount) || 0 : 0;
%>

<nav class="mobile-bottom-nav" aria-label="Mobile navigation">
  <a
    href="/"
    class="mobile-nav-link <%= mobilePage === 'home' ? 'active' : '' %>"
    <% if (mobilePage === "home") { %>aria-current="page"<% } %>
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="m3 10 9-7 9 7" />
      <path d="M5 9v12h5v-7h4v7h5V9" />
    </svg>
    <span>Home</span>
  </a>

  <a
    href="/shop"
    class="mobile-nav-link <%= mobilePage === 'shop' ? 'active' : '' %>"
    <% if (mobilePage === "shop") { %>aria-current="page"<% } %>
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M5 8h14l1 13H4L5 8Z" />
      <path d="M8 9V6a4 4 0 0 1 8 0v3" />
    </svg>
    <span>Shop</span>
  </a>

  <a
    href="/cart"
    class="mobile-nav-link <%= mobilePage === 'cart' ? 'active' : '' %>"
    aria-label="Cart, <%= mobileCartCount %> items"
    <% if (mobilePage === "cart") { %>aria-current="page"<% } %>
  >
    <span class="mobile-nav-icon">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M2 3h3l3 13h11l3-9H6" />
        <circle cx="9" cy="21" r="1" />
        <circle cx="18" cy="21" r="1" />
      </svg>

      <% if (mobileCartCount > 0) { %>
        <span class="mobile-cart-count" aria-hidden="true">
          <%= mobileCartCount > 99 ? "99+" : mobileCartCount %>
        </span>
      <% } %>
    </span>
    <span>Cart</span>
  </a>

  <a
    href="<%= mobileUser ? '/account' : '/login' %>"
    class="mobile-nav-link <%= mobilePage === 'account' ? 'active' : '' %>"
    <% if (mobilePage === "account" && mobileUser) { %>
      aria-current="page"
    <% } %>
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="12" cy="7" r="4" />
      <path d="M4 21v-2a8 8 0 0 1 16 0v2" />
    </svg>
    <span><%= mobileUser ? "Account" : "Sign In" %></span>
  </a>
</nav>