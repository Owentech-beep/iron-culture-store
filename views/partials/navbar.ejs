<header class="site-header sticky-top">
  <nav
    class="navbar navbar-expand-lg navbar-dark"
    aria-label="Main navigation"
  >
    <div class="container">
     <a
      class="navbar-brand brand d-inline-flex flex-row align-items-center gap-2"
      href="/"
      aria-label="Iron Culture Supplements home"
    >
      <img
        src="/images/logo.png"
        alt=""
        width="44"
        height="44"
        style="object-fit: contain; flex-shrink: 0;"
      >

      <span class="d-flex flex-column">
        <span class="brand-name">IRON CULTURE</span>
        <span class="brand-subtitle">SUPPLEMENTS</span>
      </span>
    </a>

      <button
        id="mobileMenuToggle"
        class="navbar-toggler"
        type="button"
        data-bs-toggle="offcanvas"
        data-bs-target="#mobileMenu"
        aria-controls="mobileMenu"
        aria-expanded="false"
        aria-label="Open navigation menu"
      >
        <span class="navbar-toggler-icon"></span>
      </button>

      <div
        class="navbar-collapse d-none d-lg-flex"
        id="mainNavbar"
      >
        <%- include("navigation-content", {
          searchInputId: "desktopHeaderSearch"
        }) %>
      </div>
    </div>
  </nav>
</header>

<div
  class="offcanvas offcanvas-start storefront-sidebar"
  tabindex="-1"
  id="mobileMenu"
  aria-labelledby="mobileMenuTitle"
  data-bs-theme="dark"
>
  <div class="offcanvas-header">
    <h2
      class="offcanvas-title brand d-flex flex-row align-items-center gap-2"
      id="mobileMenuTitle"
    >
      <img
        src="/images/logo.png"
        alt=""
        width="40"
        height="40"
        style="object-fit: contain; flex-shrink: 0;"
      >

      <span class="d-flex flex-column">
        <span class="brand-name">IRON CULTURE</span>
        <span class="brand-subtitle">SUPPLEMENTS</span>
      </span>
    </h2>

    <button
      type="button"
      class="btn-close"
      data-bs-dismiss="offcanvas"
      aria-label="Close navigation menu"
    ></button>
  </div>

  <div class="offcanvas-body">
    <div class="sidebar-content">
      <p class="eyebrow">FUEL YOUR NEXT LEVEL</p>

      <nav aria-label="Mobile sidebar navigation">
        <%- include("navigation-content", {
          searchInputId: "mobileHeaderSearch"
        }) %>
      </nav>
    </div>
  </div>
</div>

<%- include("mobile-nav") %>