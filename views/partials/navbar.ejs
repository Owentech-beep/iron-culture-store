<header class="site-header sticky-top">
  <nav
    class="navbar navbar-expand-lg navbar-dark"
    aria-label="Main navigation"
  >
    <div class="container">
      <a class="navbar-brand brand" href="/">
        <span class="brand-name">IRON CULTURE</span>
        <span class="brand-subtitle">SUPPLEMENTS</span>
      </a>

      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#mainNavbar"
        aria-controls="mainNavbar"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="mainNavbar">
        <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
          <li class="nav-item">
            <a
              class="nav-link <%= activePage === 'home' ? 'active' : '' %>"
              href="/"
              <% if (activePage === 'home') { %>aria-current="page"<% } %>
            >
              Home
            </a>
          </li>

          <li class="nav-item">
            <a
            class="nav-link <%= activePage === 'shop' ? 'active' : '' %>"
            href="/shop"
            <% if (activePage === 'shop') { %>aria-current="page"<% } %>
            >
            Shop
            </a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/#categories">Categories</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/#brands">Brands</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/#deals">Deals</a>
          </li>

          <li class="nav-item">
            <a
              class="nav-link <%= activePage === 'orders' ? 'active' : '' %>"
              href="/orders"
              <% if (activePage === 'orders') { %>aria-current="page"<% } %>
            >
              Track Order
            </a>
          </li>

          <li class="nav-item">
            <a
                class="nav-link <%= activePage === 'account' ? 'active' : '' %>"
                href="<%= typeof currentUser !== 'undefined' && currentUser
                ? '/account'
                : '/login' %>"
            >
                <%= typeof currentUser !== 'undefined' && currentUser
                ? 'My Account'
                : 'Sign In' %>
            </a>
            </li>

         <li class="nav-item">
            <a
                class="nav-link <%= activePage === 'cart' ? 'active' : '' %>"
                href="/cart"
            >
                Cart
                <span class="cart-badge">
                <%= typeof cartCount !== "undefined" ? cartCount : 0 %>
                </span>
            </a>
            </li>
        </ul>
        <form
          action="/shop"
          method="GET"
          class="header-search"
          role="search"
          aria-label="Search the catalogue"
        >
          <label for="headerSearch" class="visually-hidden">
            Search products or brands
          </label>

          <input
            id="headerSearch"
            name="q"
            type="search"
            maxlength="100"
            placeholder="Search products..."
            value="<%= typeof filters !== 'undefined' && filters ? filters.q : '' %>"
          >

          <button type="submit" aria-label="Search">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              aria-hidden="true"
              focusable="false"
            >
              <circle cx="10.5" cy="10.5" r="6.5" />
              <path d="m16 16 5 5" />
            </svg>
          </button>
        </form>
      </div>
    </div>
  </nav>
</header>
<%- include("mobile-nav") %>