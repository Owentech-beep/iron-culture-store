<%- include("partials/head") %>
<%- include("partials/navbar") %>

<main id="main-content" class="section-space">
  <div class="container">
    <section class="auth-panel">
      <p class="eyebrow">
        <%= isSandbox ? "TEST PAYMENT" : "ORDER PAYMENT" %>
      </p>

      <h1 class="section-title">
        <%= isSandbox ? "PayFast Sandbox" : "Pay with PayFast" %>
      </h1>

      <% if (isSandbox) { %>
        <div class="demo-notice">
          This is a sandbox transaction. No real money will be collected.
        </div>
      <% } %>

      <p class="text-muted-custom">
        Stock has been reserved for this order.
        <%= isSandbox
          ? "Continue to PayFast to complete the sandbox payment."
          : "Continue to PayFast to complete your payment." %>
      </p>

      <dl class="cart-summary-lines">
        <div>
          <dt><%= isSandbox ? "Test amount" : "Amount to pay" %></dt>
          <dd>
            <strong>R <%= checkout.fields.amount %></strong>
          </dd>
        </div>
      </dl>

      <p id="payfastRedirectStatus" role="status" aria-live="polite">
        Taking you to PayFast. If you are not redirected, use the button below.
      </p>

      <noscript>
        <p>JavaScript is disabled. Use Continue to PayFast below.</p>
      </noscript>

      <form
        id="payfastCheckoutForm"
        action="<%= checkout.action %>"
        method="POST"
        data-status-url="/orders/<%= orderId %>/payment"
      >

      <a
        href="/orders/<%= orderId %>/payment"
        class="btn btn-outline-brand w-100 mt-3"
      >
        Back to Payment Status
      </a>

      <p class="text-muted-custom mt-3 mb-0">
        Going back does not cancel the payment attempt or release stock.
        Check the payment status before trying again.
      </p>
    </section>
  </div>
</main>

<%- include("partials/footer") %>
<script src="/js/payfast-checkout.js?v=1" defer></script>
<%- include("partials/scripts") %>