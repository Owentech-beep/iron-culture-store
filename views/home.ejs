<%- include("partials/head") %>
<%- include("partials/navbar") %>

<main id="main-content">
  <!-- HERO -->
  <section class="home-hero has-photo">
    <div class="container">
      <div class="row">
        <div class="col-lg-8 col-xl-7">
          <div class="home-hero-content" data-aos="fade-up">
            <p class="eyebrow">IRON CULTURE SUPPLEMENTS</p>

            <h1 class="hero-title">
              FUEL YOUR
              <span>NEXT LEVEL.</span>
            </h1>

            <p class="hero-description">
              Better nutrition. More energy. Greater results.
            </p>

            <p class="hero-supporting">
              Your training. Your goals. Your next level.
            </p>

            <div class="hero-actions d-flex flex-column flex-sm-row gap-3">
              <a href="/shop" class="btn btn-brand">
                Shop Supplements
                <span aria-hidden="true">→</span>
              </a>

              <a href="#deals" class="btn btn-outline-brand">
                Explore Deals
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="hero-bottom-label" aria-hidden="true">
      IRON CULTURE / BUILT AROUND YOUR GOALS
    </div>
  </section>

    <!-- CATEGORIES -->
  <section
    id="categories"
    class="home-category-strip"
    aria-labelledby="categories-heading"
  >
    <div class="container">
      <h2 id="categories-heading" class="visually-hidden">
        Shop by Category
      </h2>

      <% if (categories.length > 0) { %>
        <nav class="home-category-nav" aria-label="Product categories">
          <ul class="home-category-list">
            <% categories.forEach((category) => { %>
              <li>
                <a
                  class="home-category-link"
                  href="/shop/<%= encodeURIComponent(category.slug) %>"
                >
                  <svg
                    class="home-category-icon"
                    viewBox="0 0 32 32"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <rect x="11" y="3" width="10" height="5" rx="1" />
                    <path d="M11 8v3l-4 4v11a3 3 0 0 0 3 3h12a3 3 0 0 0 3-3V15l-4-4V8" />
                    <rect x="11" y="17" width="10" height="7" rx="1" />
                    <path d="M16 18.5v4M14 20.5h4" />
                  </svg>

                  <span class="home-category-copy">
                    <strong><%= category.name %></strong>
                    <span><%= category.description %></span>
                  </span>

                  <span class="home-category-arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            <% }); %>
          </ul>
        </nav>
      <% } else { %>
        <p class="home-category-empty">
          Categories will appear here as the catalogue is added.
        </p>
      <% } %>
    </div>
  </section>


  <!-- PRODUCT SECTION -->
  <section
    id="catalogue"
    class="section-space catalogue-section"
    aria-labelledby="products-heading"
  >
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">EXPLORE THE RANGE</p>
          <h2 id="products-heading" class="section-title">
            Featured Products
         </h2>
        </div>
      </div>

      <% if (featuredProducts.length === 0) { %>
        <div class="catalogue-empty">
          <div class="empty-mark" aria-hidden="true">IC</div>

          <div>
            <h3>The next level is taking shape.</h3>
            <p>
              Our product range is being prepared.
              Check back for available supplements and training essentials.
            </p>
          </div>
        </div>
      <% } else { %>
        <div class="row g-3">
            <% featuredProducts.forEach((product, index) => { %>
            <div
              class="col-6 col-lg-3"
              data-aos="fade-up"
              data-aos-delay="<%= (index % 4) * 50 %>"
            >
              <%- include("partials/product-card", { product }) %>
            </div>
          <% }); %>
        </div>
        <% } %>
    </div>
  </section>

  <!-- STACK PROMOTION -->
 <% if (goalCollections.length > 0) { %>
      <section
        id="goals"
        class="section-space"
        aria-labelledby="goals-heading"
      >
        <div class="container">
          <p class="eyebrow">START WITH YOUR GOAL</p>

          <h2 id="goals-heading" class="section-title">
            Explore Your Stack
          </h2>

          <p class="text-muted-custom">
            Explore our curated product collections.
            Choose sizes and flavours on each product page.
          </p>

          <nav
            class="d-flex flex-wrap gap-2 mb-4"
            aria-label="Product goals"
          >
            <% goalCollections.forEach((goal) => { %>
              <a
                href="/?goal=<%= encodeURIComponent(goal.slug) %>#goals"
                class="btn <%= selectedGoal.slug === goal.slug
                  ? 'btn-brand'
                  : 'btn-outline-brand' %>"
                <% if (selectedGoal.slug === goal.slug) { %>
                  aria-current="true"
                <% } %>
              >
                <%= goal.name %>
              </a>
            <% }); %>
          </nav>

          <h3 class="h4 mb-3"><%= selectedGoal.name %></h3>

          <div class="row g-3">
            <% selectedGoal.products.forEach((product) => { %>
              <div class="col-6 col-lg-3">
                <%- include("partials/product-card", { product }) %>
              </div>
            <% }); %>
          </div>

          <p class="text-muted-custom mt-3 mb-0">
            Products are sold separately. A collection is not a personalised
            supplement plan or an instruction to use every product together.
            Check each product's ingredients and directions.
          </p>
        </div>
      </section>
    <% } %>

   <!-- DEALS -->
  <section
    id="deals"
    class="section-space"
    aria-labelledby="deals-heading"
  >
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">EXPLORE THE OFFERS</p>
          <h2 id="deals-heading" class="section-title">
            Latest Deals
          </h2>
        </div>
      </div>

      <% if (dealProducts.length === 0) { %>
        <div class="notice-panel">
          <p class="mb-0">
            There are no active promotions to display.
            Available offers will appear here.
          </p>
        </div>
      <% } else { %>
        <div class="row g-3">
          <% dealProducts.forEach((product, index) => { %>
            <div
              class="col-6 col-lg-3"
              data-aos="fade-up"
              data-aos-delay="<%= (index % 4) * 50 %>"
            >
              <%- include("partials/product-card", { product }) %>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </section>

  <!-- BRANDS -->
  <section
    id="brands"
    class="brands-section"
    aria-labelledby="brands-heading"
  >
    <div class="container">
      <div class="row gy-3 align-items-center">
        <div class="col-md-4">
          <p class="eyebrow">THE LINEUP</p>
          <h2 id="brands-heading" class="section-title mb-0">
            Our Brands
          </h2>
        </div>

        <div class="col-md-8">
        <% if (brands.length === 0) { %>
            <p class="text-muted-custom mb-0">
                Confirmed brands will appear here when the catalogue launches.
            </p>
            <% } else { %>
            <div class="brand-lineup-grid">
                <% brands.forEach((brand) => { %>
                  <a
                    href="/shop?brand=<%= encodeURIComponent(brand.slug) %>"
                    class="brand-lineup-card"
                  >
                    <% if (brand.logo_url) { %>
                      <img
                        src="<%= brand.logo_url %>"
                        alt=""
                        width="240"
                        height="120"
                        loading="lazy"
                        decoding="async"
                      >
                    <% } %>

                    <span><%= brand.name %></span>
                  </a>
                <% }); %>
              </div>
            <% } %>
        </div>
      </div>
    </div>
  </section>

  <!-- NEWSLETTER: NO DATA COLLECTION UNTIL BACKEND EXISTS -->
  <section
  id="newsletter"
  class="section-space"
  aria-labelledby="newsletter-heading"
>
  <div class="container">
    <div class="newsletter-panel">
      <div>
        <p class="eyebrow">STAY IN THE LOOP</p>

        <h2 id="newsletter-heading" class="section-title">
          Stay Close to the Culture
        </h2>

        <p class="text-muted-custom">
          Product launches, training essentials and offers.
          Confirm your email to join the newsletter.
        </p>
      </div>

      <form
        action="/newsletter/subscribe"
        method="POST"
        class="newsletter-signup"
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <label for="newsletterEmail" class="form-label">
          Email address
        </label>

        <input
          id="newsletterEmail"
          name="email"
          type="email"
          class="form-control"
          autocomplete="email"
          maxlength="254"
          placeholder="you@example.com"
          required
        >

        <div class="form-check my-3">
          <input
            id="newsletterConsent"
            name="consent"
            value="yes"
            type="checkbox"
            class="form-check-input"
            required
          >

          <label for="newsletterConsent" class="form-check-label">
            Email me Iron Culture product news and offers.
            I can unsubscribe at any time.
          </label>
        </div>

        <button type="submit" class="btn btn-brand w-100">
          Join the Newsletter
        </button>
      </form>
    </div>
  </div>
</section>
</main>

<%- include("partials/footer") %>
<%- include("partials/scripts") %>