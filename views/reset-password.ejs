<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="referrer" content="no-referrer">
  <meta name="robots" content="noindex, nofollow">
  <title>Choose a New Password | Iron Culture</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <main id="main-content" class="section-space">
    <div class="container">
      <section class="auth-panel">
        <p class="eyebrow">ACCOUNT ACCESS</p>
        <h1 class="section-title">Password Reset</h1>

        <% if (completed) { %>
          <div class="notice-panel mb-4" role="status">
            Your password has been changed.
            Your previous login sessions have been invalidated.
            Sign in using your new password.
          </div>

          <a href="/login" class="btn btn-brand">
            Sign In
          </a>
        <% } else if (!valid) { %>
          <div class="notice-panel mb-4" role="alert">
            This reset link is invalid, expired or already used.
          </div>

          <a href="/forgot-password" class="btn btn-outline-brand">
            Request a New Link
          </a>
        <% } else { %>
          <% if (errors.length) { %>
            <div class="notice-panel mb-4" role="alert">
              <ul class="mb-0">
                <% errors.forEach((error) => { %>
                  <li><%= error %></li>
                <% }); %>
              </ul>
            </div>
          <% } %>

          <form action="/reset-password" method="POST">
            <input
              type="hidden"
              name="_csrf"
              value="<%= csrfToken %>"
            >
            <input
              type="hidden"
              name="token"
              value="<%= token %>"
            >

            <div class="mb-3">
              <label for="new-password" class="form-label">
                New password
              </label>
              <input
                id="new-password"
                name="password"
                type="password"
                class="form-control"
                autocomplete="new-password"
                minlength="15"
                maxlength="72"
                aria-describedby="password-help"
                required
              >
              <p id="password-help" class="text-muted-custom mt-2">
                Use at least 15 characters, within 72 UTF-8 bytes.
              </p>
            </div>

            <div class="mb-3">
              <label for="confirm-password" class="form-label">
                Confirm new password
              </label>
              <input
                id="confirm-password"
                name="confirmPassword"
                type="password"
                class="form-control"
                autocomplete="new-password"
                minlength="15"
                maxlength="72"
                required
              >
            </div>

            <button type="submit" class="btn btn-brand w-100">
              Save New Password
            </button>
          </form>
        <% } %>
      </section>
    </div>
  </main>
</body>
</html>