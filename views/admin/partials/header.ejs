<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title><%= pageTitle %></title>
  <meta name="description" content="<%= metaDescription %>">
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#0D0D0D">

  <link
    rel="stylesheet"
    href="/vendor/bootstrap/css/bootstrap.min.css"
  >
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>

<body class="admin-body">
  <a class="skip-link" href="#main-content">Skip to content</a>

  <header class="admin-header">
    <div class="container-fluid d-flex align-items-center
                justify-content-between gap-3">
      <a href="/admin" class="brand">
        <span class="brand-name">IRON CULTURE</span>
        <span class="brand-subtitle">ADMINISTRATION</span>
      </a>

      <div class="d-flex align-items-center gap-3">
        <span class="admin-user d-none d-md-inline">
          <%= currentUser.name %>
        </span>

        <a href="/" class="admin-store-link">View Store</a>

        <button
          type="button"
          class="btn btn-outline-brand d-lg-none"
          data-bs-toggle="collapse"
          data-bs-target="#adminNavigation"
          aria-controls="adminNavigation"
          aria-expanded="false"
        >
          Menu
        </button>
      </div>
    </div>
  </header>

  <div class="admin-layout">
    <aside class="admin-sidebar">
      <nav
        id="adminNavigation"
        class="collapse d-lg-block"
        aria-label="Administration"
      >
        <p class="admin-nav-heading">Store Management</p>

        <a
          href="/admin"
          class="admin-nav-link <%= adminPage === 'dashboard' ? 'active' : '' %>"
          <% if (adminPage === "dashboard") { %>
            aria-current="page"
          <% } %>
        >
          Dashboard
        </a>

        <a
        href="/admin/orders"
        class="admin-nav-link <%= adminPage === 'orders' ? 'active' : '' %>"
        >
        Orders
        </a>

        <a
          href="/admin/customers"
          class="admin-nav-link <%= adminPage === 'customers' ? 'active' : '' %>"
        >
          Customers
        </a>

       <a
        href="/admin/products"
        class="admin-nav-link <%= adminPage === 'products' ? 'active' : '' %>"
        >
        Products
        </a>

        <a
        href="/admin/catalogue/categories"
        class="admin-nav-link <%= adminPage === 'categories' ? 'active' : '' %>"
        >
        Categories
        </a>

        <a
        href="/admin/catalogue/brands"
        class="admin-nav-link <%= adminPage === 'brands' ? 'active' : '' %>"
        >
        Brands
        </a>

        <a
        href="/admin/inventory"
        class="admin-nav-link <%= adminPage === 'inventory' ? 'active' : '' %>"
        >
        Inventory
        </a>

        <a
          href="/admin/goals"
          class="admin-nav-link <%= adminPage === 'goals' ? 'active' : '' %>"
          <% if (adminPage === "goals") { %>aria-current="page"<% } %>
        >
          Goal Collections
        </a>

        <a href="/account" class="admin-nav-link">
          My Account
        </a>

        <form action="/logout" method="POST" class="mt-3">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <button type="submit" class="admin-nav-link admin-logout">
            Sign Out
          </button>
        </form>
      </nav>
    </aside>

    <main id="main-content" class="admin-main">