<details class="mt-3">
  <summary class="text-danger">
    Permanently delete
  </summary>

  <form
    action="/admin/cleanup/<%= deleteKind %>/<%= deleteEntry.id %>"
    method="POST"
    class="mt-3"
  >
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <input
      type="hidden"
      name="expectedSlug"
      value="<%= deleteEntry.slug %>"
    >

    <p class="text-muted-custom small">
      <% if (deleteKind === "products") { %>
        Remove <strong><%= deleteEntry.name %></strong> from sale and carts.
        If it has no order or reservation history, the product and all its
        inventory records will be permanently deleted, even if stock remains.
        Otherwise, it will be retired and its history and stock preserved.
      <% } else { %>
        Delete <strong><%= deleteEntry.name %></strong> permanently.
        Products must be reassigned before deleting this entry.
      <% } %>
    </p>

    <label
      for="delete-<%= deleteKind %>-<%= deleteEntry.id %>"
      class="form-label"
    >
      Type DELETE to confirm
    </label>

    <input
      id="delete-<%= deleteKind %>-<%= deleteEntry.id %>"
      name="confirmation"
      type="text"
      class="form-control mb-2"
      autocomplete="off"
      spellcheck="false"
      pattern="DELETE"
      maxlength="6"
      required
    >

    <button type="submit" class="btn btn-outline-danger">
      <%= deleteKind === "products" ? "Remove Product" : "Delete Permanently" %>
    </button>
  </form>
</details>