<%- include("partials/header") %>

<div class="admin-page-heading">
  <div>
    <p class="eyebrow">CATALOGUE MANAGEMENT</p>

    <h1 class="section-title mb-0">
      <%= values.id ? "Edit Product" : "Add Product" %>
    </h1>
  </div>

  <a href="/admin/products" class="btn btn-outline-brand">
    Back to Products
  </a>
</div>

<% if (errors.length > 0) { %>
  <div class="auth-errors" role="alert">
    <ul class="mb-0">
      <% errors.forEach((error) => { %>
        <li><%= error %></li>
      <% }); %>
    </ul>
  </div>
<% } %>

<form
  action="<%= values.id ? '/admin/products/' + values.id : '/admin/products' %>"
  method="POST"
  class="admin-panel admin-form p-4"
>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="row g-3">
    <div class="col-md-12">
      <label for="name" class="form-label">Product name</label>
      <input
        id="name"
        name="name"
        class="form-control"
        maxlength="180"
        value="<%= values.name || '' %>"
        required
      >
    </div>

    <div class="col-md-6">
      <label for="category_id" class="form-label">Category</label>
      <select id="category_id" name="category_id" class="form-select" required>
        <option value="">Choose a category</option>

        <% categories.forEach((category) => { %>
          <option
            value="<%= category.id %>"
            <%= Number(values.category_id) === category.id ? "selected" : "" %>
          >
            <%= category.name %>
          </option>
        <% }); %>
      </select>
    </div>

    <div class="col-md-6">
      <label for="brand_id" class="form-label">Brand</label>
      <select id="brand_id" name="brand_id" class="form-select" required>
        <option value="">Choose a brand</option>

        <% brands.forEach((brand) => { %>
          <option
            value="<%= brand.id %>"
            <%= Number(values.brand_id) === brand.id ? "selected" : "" %>
          >
            <%= brand.name %>
          </option>
        <% }); %>
      </select>
    </div>

    <div class="col-md-6">
      <label for="price" class="form-label">Price (R)</label>
      <input
        id="price"
        name="price"
        type="number"
        min="0.01"
        max="9999999.99"
        step="0.01"
        class="form-control"
        value="<%= values.price ?? '' %>"
        required
      >
    </div>

    <div class="col-md-6">
      <label for="sale_price" class="form-label">Sale price (optional)</label>
      <input
        id="sale_price"
        name="sale_price"
        type="number"
        min="0.01"
        max="9999999.99"
        step="0.01"
        class="form-control"
        value="<%= values.sale_price ?? '' %>"
      >
    </div>

    <div class="col-12">
      <label for="image_url" class="form-label">Main image URL or path</label>
      <input
        id="image_url"
        name="image_url"
        class="form-control"
        maxlength="1000"
        placeholder="/images/product-front.jpg"
        value="<%= values.image_url || '' %>"
      >

      <p class="auth-help">
       Use the image uploader below after saving the product.
       The uploaded image URL will appear here.
       Leave blank to remove the main image when saving.
      </p>
    </div>

    <% const textFields = [
      ["short_description", "Short description"],
      ["description", "Full description"],
      ["ingredients", "Ingredients"],
      ["allergens", "Allergen information"]
    ]; %>

    <% textFields.forEach(([key, label]) => { %>
      <div class="col-12">
        <label for="<%= key %>" class="form-label"><%= label %></label>

        <textarea
          id="<%= key %>"
          name="<%= key %>"
          class="form-control"
          rows="<%= key === 'description' ? 6 : 3 %>"
          maxlength="5000"
        ><%= values[key] || '' %></textarea>
      </div>
    <% }); %>

    <div class="col-12">
      <% const flags = [
        ["is_active", "Published"],
        ["is_featured", "Featured on homepage"],
        ["is_demo", "Demo product — exclude from live payments"]
      ]; %>

      <% flags.forEach(([key, label]) => { %>
        <div class="form-check mb-3">
          <input
            id="<%= key %>"
            name="<%= key %>"
            type="checkbox"
            class="form-check-input"
            <%= values[key] ? "checked" : "" %>
          >

          <label for="<%= key %>" class="form-check-label">
            <%= label %>
          </label>
        </div>
      <% }); %>

      <button class="btn btn-brand" type="submit">
        Save Product
      </button>
    </div>
  </div>
</form>

<% if (values.id) { %>
  <section class="admin-panel p-4 mt-4">
    <h2 class="h5 mb-3">Sizes and Flavours</h2>

    <p class="text-muted-custom">
      Each size and flavour combination has its own price, SKU and stock.
      Leave flavour blank for unflavoured products.
    </p>

    <div class="table-responsive mb-4">
      <table class="table admin-table">
        <thead>
          <tr>
            <th scope="col">Size</th>
            <th scope="col">Flavour</th>
            <th scope="col">Regular Price</th>
            <th scope="col">Sale Price</th>
            <th scope="col">SKU</th>
            <th scope="col">Physical Stock</th>
          </tr>
        </thead>

        <tbody>
          <% values.variants.forEach((variant) => { %>
            <tr>
              <td><%= variant.size || "Size not assigned" %></td>
              <td><%= variant.flavour %></td>
              <td>
                <%= variant.price == null
                  ? "Uses product price"
                  : `R ${Number(variant.price).toFixed(2)}` %>
              </td>
              <td>
                <%= variant.sale_price == null
                  ? "—"
                  : `R ${Number(variant.sale_price).toFixed(2)}` %>
              </td>
              <td class="admin-sku"><%= variant.sku %></td>
              <td><%= variant.quantity %></td>
            </tr>
          <% }); %>

          <% if (values.variants.length === 0) { %>
            <tr>
              <td colspan="6">
                Add a size and flavour combination before stocking this product.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <form
      action="/admin/products/<%= values.id %>/variants"
      method="POST"
      class="admin-form"
    >
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="row g-3">
        <div class="col-md-6">
          <label for="variantSize" class="form-label">Size</label>
          <input
            id="variantSize"
            name="size"
            class="form-control"
            list="supplementSizes"
            maxlength="80"
            placeholder="Choose or enter a size"
            required
          >

          <datalist id="supplementSizes">
            <option value="250 g">
            <option value="500 g">
            <option value="1 kg">
            <option value="2 kg">
            <option value="30 capsules">
            <option value="60 capsules">
            <option value="120 capsules">
            <option value="30 tablets">
            <option value="60 tablets">
            <option value="30 servings">
          </datalist>
        </div>

        <div class="col-md-6">
          <label for="variantFlavour" class="form-label">
            Flavour (optional)
          </label>
          <input
            id="variantFlavour"
            name="flavour"
            class="form-control"
            maxlength="100"
            placeholder="Chocolate, Vanilla, or leave blank"
          >
        </div>

        <div class="col-md-6">
          <label for="variantPrice" class="form-label">
            Price for this option (R)
          </label>
          <input
            id="variantPrice"
            name="price"
            type="number"
            class="form-control"
            min="0.01"
            max="9999999.99"
            step="0.01"
            required
          >
        </div>

        <div class="col-md-6">
          <label for="variantSalePrice" class="form-label">
            Sale price for this option (optional)
          </label>
          <input
            id="variantSalePrice"
            name="sale_price"
            type="number"
            class="form-control"
            min="0.01"
            max="9999999.99"
            step="0.01"
          >
        </div>

        <div class="col-12">
          <button type="submit" class="btn btn-brand">
            Add Size and Flavour
          </button>
        </div>
      </div>
    </form>

    <a href="/admin/inventory" class="btn btn-outline-brand mt-3">
      Manage Stock
    </a>
  </section>
<% } else { %>
  <p class="text-muted-custom mt-3">
    Save the product first, then add its sizes, flavours and stock.
  </p>
<% } %>

<% if (values.id) { %>
  <section class="admin-panel p-4 mt-4">
    <h2 class="h5 mb-3">Main Product Image</h2>

    <% if (values.image_url) { %>
      <img
        src="<%= values.image_url %>"
        alt="Current main product image"
        class="admin-image-preview mb-3"
        width="240"
        height="240"
      >
    <% } %>

    <p class="text-muted-custom">
      Save any product edits before uploading. The page reloads after
      a successful upload.
    </p>

    <form
      id="mainImageUpload"
      action="/admin/products/<%= values.id %>/image"
      method="POST"
      enctype="multipart/form-data"
      data-csrf="<%= csrfToken %>"
      class="admin-form"
    >
      <label for="mainImageFile" class="form-label">
        JPEG, PNG or WebP — maximum 5 MB
      </label>

      <input
        id="mainImageFile"
        name="image"
        type="file"
        accept="image/jpeg,image/png,image/webp"
        class="form-control mb-3"
        required
      >

      <button type="submit" class="btn btn-brand">
        Upload Main Image
      </button>

      <p
        id="imageUploadStatus"
        class="text-muted-custom mt-3 mb-0"
        role="status"
        aria-live="polite"
      ></p>
    </form>

    <noscript>
      <p class="cart-warning">
        Enable JavaScript to use the image uploader.
      </p>
    </noscript>
  </section>

  <% if (values.id) { %>
  <section class="admin-panel p-4 mt-4">
    <h2 class="h5 mb-3">Nutrition Label</h2>

    <p class="text-muted-custom">
      Upload a clear manufacturer nutrition label.
      Use a shared label only when it applies to every size and flavour.
      Save other product edits before uploading.
    </p>

    <% if (values.nutrition_image_url) { %>
      <a
        href="<%= values.nutrition_image_url %>"
        target="_blank"
        rel="noopener"
      >
        <img
          src="<%= values.nutrition_image_url %>"
          alt="Current nutrition label"
          class="img-fluid mb-3"
          style="max-height: 400px; object-fit: contain;"
        >
      </a>
    <% } %>

    <form
      action="/admin/products/<%= values.id %>/nutrition-image"
      method="POST"
      enctype="multipart/form-data"
      class="admin-form"
      data-nutrition-form
      data-csrf="<%= csrfToken %>"
    >
      <label for="nutritionImageFile" class="form-label">
        JPEG, PNG or WebP — maximum 5 MB
      </label>

      <input
        id="nutritionImageFile"
        name="image"
        type="file"
        accept="image/jpeg,image/png,image/webp"
        class="form-control mb-3"
        required
      >

      <button type="submit" class="btn btn-brand">
        <%= values.nutrition_image_url ? "Replace Label" : "Upload Label" %>
      </button>

      <p data-upload-status role="status" aria-live="polite"
         class="text-muted-custom mt-3 mb-0"></p>
    </form>

    <% if (values.nutrition_image_url) { %>
      <form
        action="/admin/products/<%= values.id %>/nutrition-image/remove"
        method="POST"
        class="mt-3"
        data-nutrition-form
        data-csrf="<%= csrfToken %>"
      >
        <button type="submit" class="btn btn-outline-danger">
          Remove Label
        </button>

        <p data-upload-status role="status" aria-live="polite"
           class="text-muted-custom mt-2 mb-0"></p>
      </form>
    <% } %>

    <noscript>
      <p>Enable JavaScript to upload or remove nutrition labels.</p>
    </noscript>
  </section>

  <script src="/js/admin-nutrition.js" defer></script>
<% } %>

  <script src="/js/admin-image.js" defer></script>
<% } %>

<%- include("partials/footer") %>