<%- include("partials/header") %>

<div class="admin-page-heading">
  <div>
    <p class="eyebrow">CATALOGUE SETTINGS</p>
    <h1 class="section-title mb-0"><%= title %></h1>
  </div>
</div>

<section class="admin-panel p-4 mb-4">
  <h2 class="h5 mb-3">
    Add <%= kind === "categories" ? "Category" : "Brand" %>
  </h2>

  <form
    action="/admin/catalogue/<%= kind %>"
    method="POST"
    class="admin-form"
  >
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="row g-3">
      <div class="col-md-6">
        <label for="newName" class="form-label">Name</label>
        <input
          id="newName"
          name="name"
          class="form-control"
          maxlength="100"
          required
        >
      </div>

      <div class="col-md-6">
        <label for="newSlug" class="form-label">URL slug</label>
        <input
          id="newSlug"
          name="slug"
          class="form-control"
          maxlength="120"
          placeholder="lowercase-with-hyphens"
          required
        >
      </div>

      <% if (kind === "brands") { %>
        <div class="col-12">
          <div class="form-check">
            <input
              id="newDemo"
              name="is_demo"
              type="checkbox"
              class="form-check-input"
              checked
            >
            <label for="newDemo" class="form-check-label">
              Demo brand
            </label>
          </div>
        </div>
      <% } %>

      <div class="col-12">
        <button type="submit" class="btn btn-brand">Add</button>
      </div>
    </div>
  </form>
</section>

<p class="text-muted-custom">
  Keep existing slugs unchanged where possible to preserve links.
  Changes below affect the products assigned to each entry.
</p>

<% entries.forEach((entry) => { %>
  <section class="admin-panel p-4 mb-3">
    <form
      action="/admin/catalogue/<%= kind %>/<%= entry.id %>"
      method="POST"
      class="admin-form"
    >
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="row g-3 align-items-end">
        <div class="col-md-5">
          <label for="name-<%= entry.id %>" class="form-label">Name</label>
          <input
            id="name-<%= entry.id %>"
            name="name"
            class="form-control"
            maxlength="100"
            value="<%= entry.name %>"
            required
          >
        </div>

        <div class="col-md-5">
          <label for="slug-<%= entry.id %>" class="form-label">URL slug</label>
          <input
            id="slug-<%= entry.id %>"
            name="slug"
            class="form-control"
            maxlength="120"
            value="<%= entry.slug %>"
            required
          >
        </div>

        <div class="col-md-2">
          <button type="submit" class="btn btn-outline-brand w-100">
            Save
          </button>
        </div>

        <% if (kind === "brands") { %>
          <div class="col-12">
            <div class="form-check">
              <input
                id="demo-<%= entry.id %>"
                name="is_demo"
                type="checkbox"
                class="form-check-input"
                <%= entry.is_demo ? "checked" : "" %>
              >
              <label for="demo-<%= entry.id %>" class="form-check-label">
                Demo brand
              </label>
            </div>
          </div>
        <% } %>
      </div>
    </form>
    <% if (kind === "brands") { %>
        <div class="brand-logo-editor mt-4 pt-4 border-top">
          <h3 class="h6">Brand Logo</h3>

          <div class="brand-logo-preview mb-3">
            <img
              data-brand-logo-preview="<%= entry.id %>"
              src="<%= entry.logo_url || '' %>"
              alt="<%= entry.name %> logo"
              width="220"
              height="110"
              <% if (!entry.logo_url) { %>hidden<% } %>
            >

            <span
              data-brand-logo-placeholder="<%= entry.id %>"
              class="text-muted-custom"
              <% if (entry.logo_url) { %>hidden<% } %>
            >
              No logo uploaded
            </span>
          </div>

          <form
            action="/admin/catalogue/brands/<%= entry.id %>/logo"
            method="POST"
            enctype="multipart/form-data"
            class="admin-form brand-logo-upload"
            data-brand-id="<%= entry.id %>"
          >
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <label for="brand-logo-<%= entry.id %>" class="form-label">
              Choose a logo
            </label>

            <input
              id="brand-logo-<%= entry.id %>"
              name="logo"
              type="file"
              class="form-control mb-2"
              accept="image/jpeg,image/png,image/webp"
              required
            >

            <p class="text-muted-custom small">
              JPEG, PNG or WebP. Maximum 5 MB.
              A transparent PNG or WebP works well for logos.
            </p>

            <button type="submit" class="btn btn-outline-brand">
              Upload Logo
            </button>

            <p
              class="brand-logo-upload-status mt-2 mb-0"
              role="status"
              aria-live="polite"
            ></p>
          </form>
        </div>
      <% } %>
  </section>
<% }); %>
<% if (kind === "brands") { %>
  <script src="/js/admin-brand-logos.js" defer></script>
<% } %>
<%- include("partials/footer") %>