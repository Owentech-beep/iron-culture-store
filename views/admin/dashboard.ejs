<%- include("partials/header") %>

<div class="admin-page-heading">
  <div>
    <p class="eyebrow">STORE OVERVIEW</p>
    <h1 class="section-title mb-0">Dashboard</h1>
  </div>

  <span class="admin-status">Live database data</span>
</div>

<div class="row g-3 mb-4">
  <div class="col-sm-6 col-xl-3">
    <section class="admin-stat">
      <h2>Paid Sales</h2>
      <strong><%= formatMoney(dashboard.salesCents) %></strong>
      <p>Includes delivery charges · Demo orders excluded</p>
    </section>
  </div>

  <div class="col-sm-6 col-xl-3">
  <section class="admin-stat">
    <h2>Cost of Goods Sold</h2>

    <strong>
      <%= formatMoney(costSummary.known_cogs_cents) %>
    </strong>

    <% if (costSummary.missing_cost_orders > 0) { %>
      <p>
        Incomplete: <%= costSummary.missing_cost_orders %>
        paid orders need cost records.
      </p>
    <% } else { %>
      <p>Recorded product cost for paid, non-demo orders</p>
    <% } %>
  </section>
</div>

<div class="col-sm-6 col-xl-3">
  <section class="admin-stat">
    <h2>Gross Profit</h2>

    <strong>
      <%= costSummary.gross_profit_cents === null
        ? "Cost missing"
        : formatMoney(costSummary.gross_profit_cents) %>
    </strong>

    <p>
      Product revenue after discounts minus recorded product costs.
      Delivery charges and other expenses excluded.
    </p>
  </section>
</div>

<div class="col-sm-6 col-xl-3">
  <section class="admin-stat">
    <h2>Stock Purchases</h2>

    <strong>
      <%= formatMoney(costSummary.purchases_cents) %>
    </strong>

    <p>Recorded purchases · Opening balances and demo stock excluded</p>

    <a href="/admin/inventory" class="btn btn-outline-brand">
      Manage Costs
    </a>
  </section>
</div>

  <div class="col-sm-6 col-xl-3">
    <section class="admin-stat">
      <h2>Orders</h2>
      <strong><%= dashboard.orders.total %></strong>
      <p>
        <%= dashboard.orders.demo %> demo ·
        <%= dashboard.orders.pending %> pending
      </p>
    </section>
  </div>

  <div class="col-sm-6 col-xl-3">
    <section class="admin-stat">
      <h2>Customers</h2>
      <strong><%= dashboard.customers %></strong>
      <p>Accounts with customer role</p>
    </section>
  </div>

  <div class="col-sm-6 col-xl-3">
    <section class="admin-stat">
      <h2>Products</h2>
      <strong><%= dashboard.products.total %></strong>
      <p>
        <%= dashboard.products.active %> active ·
        <%= dashboard.products.demo %> demo
      </p>
    </section>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-6">
    <section class="admin-attention">
      <div>
        <h2>Delivery Quotes Required</h2>
        <p>Pending orders waiting for a delivery charge</p>
      </div>

      <strong><%= dashboard.orders.awaiting_quote %></strong>
    </section>
  </div>

  <div class="col-md-6">
    <section class="admin-attention">
      <div>
        <h2>Low-stock Options</h2>
        <p>Active variants at or below their stock threshold</p>
      </div>

      <strong><%= dashboard.lowStockCount %></strong>
    </section>
  </div>
</div>

<section class="admin-panel mb-4">
  <div class="admin-panel-heading">
    <h2>Order Emails</h2>
    <span>
      <%= emailOverview.summary.total %> total ·
      <%= emailOverview.summary.demo %> demo
    </span>
  </div>

  <div class="p-3">
    <dl class="row g-3 mb-3">
      <div class="col-6 col-lg-3">
        <dt>Pending</dt>
        <dd class="h4 mb-0">
          <%= emailOverview.summary.pending %>
        </dd>
      </div>

      <div class="col-6 col-lg-3">
        <dt>Sending</dt>
        <dd class="h4 mb-0">
          <%= emailOverview.summary.sending %>
        </dd>
      </div>

      <div class="col-6 col-lg-3">
        <dt>Accepted by provider</dt>
        <dd class="h4 mb-0">
          <%= emailOverview.summary.sent %>
        </dd>
      </div>

      <div class="col-6 col-lg-3">
        <dt>Needs attention</dt>
        <dd class="h4 mb-0">
          <%= emailOverview.summary.failed
            + emailOverview.summary.review_required
            + emailOverview.summary.stalled %>
        </dd>
      </div>
    </dl>

    <p class="text-muted-custom mb-0">
      Counts include demo emails. Provider acceptance does not confirm
      inbox delivery. Stalled sends are also included in Sending.
    </p>

    <% if (emailOverview.summary.stalled > 0) { %>
      <div class="notice-panel mt-3">
        <%= emailOverview.summary.stalled %> sending attempt(s)
        have been held for over five minutes.
        Check the provider's records before attempting recovery.
      </div>
    <% } %>
  </div>

  <% if (emailOverview.recent.length === 0) { %>
    <p class="admin-empty">No order emails have been queued.</p>
  <% } else { %>
    <div class="table-responsive">
      <table class="table admin-table">
        <caption class="visually-hidden">
          Latest 10 order emails. Times shown in South African time.
        </caption>

        <thead>
          <tr>
            <th scope="col">Order</th>
            <th scope="col">Email</th>
            <th scope="col">Status</th>
            <th scope="col">Attempts</th>
            <th scope="col">Queued</th>
            <th scope="col">Details</th>
          </tr>
        </thead>

        <tbody>
          <% emailOverview.recent.forEach((email) => { %>
            <tr>
              <td>
                <a
                  class="admin-order-number"
                  href="/admin/orders/<%= email.order_id %>"
                >
                  <%= email.order_number %>
                </a>

                <% if (email.is_demo) { %>
                  <span class="demo-label d-inline-block mt-2 mb-0">
                    Demo
                  </span>
                <% } %>
              </td>

              <td>
                <%= emailEventLabels[email.event_type] ?? email.event_type %>

                <% if (email.event_type === "delivery_quote_ready") { %>
                  <span class="d-block text-muted-custom">
                    Version <%= email.event_version %>
                  </span>
                <% } %>
              </td>

              <td>
                <%= emailStatusLabels[email.status] ?? email.status %>

                <% if (email.stalled) { %>
                  <strong class="d-block">Stalled — review needed</strong>
                <% } %>
              </td>

              <td><%= email.attempt_count %></td>

              <td><%= formatDateTime(email.created_at) %></td>

              <td class="text-break">
                <%= email.last_error || "—" %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<section class="admin-panel mb-4">
  <div class="admin-panel-heading">
    <h2>Recent Orders</h2>
    <span>Latest 8</span>
  </div>

  <% if (dashboard.recentOrders.length === 0) { %>
    <p class="admin-empty">No orders have been submitted.</p>
  <% } else { %>
    <div class="table-responsive">
      <table class="table admin-table">
        <thead>
          <tr>
            <th scope="col">Order</th>
            <th scope="col">Customer</th>
            <th scope="col">Date</th>
            <th scope="col">Total</th>
            <th scope="col">Payment</th>
            <th scope="col">Order Status</th>
          </tr>
        </thead>

        <tbody>
          <% dashboard.recentOrders.forEach((order) => { %>
            <tr>
              <td>
                <span class="admin-order-number">
                  <%= order.order_number %>
                </span>

                <% if (order.is_demo) { %>
                  <span class="demo-label d-inline-block mt-2 mb-0">
                    Demo
                  </span>
                <% } %>
              </td>

              <td><%= order.customer_name %></td>
              <td><%= formatDate(order.created_at) %></td>

              <td>
                <%= order.total_cents === null
                  ? "Awaiting quote"
                  : formatMoney(order.total_cents) %>
              </td>

              <td><%= order.payment_status %></td>
              <td><%= order.status %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<section class="admin-panel">
  <div class="admin-panel-heading">
    <h2>Low Stock and Out of Stock</h2>
    <span>Lowest 10 options</span>
  </div>

  <% if (dashboard.lowStockItems.length === 0) { %>
    <p class="admin-empty">
      No active product options are below their stock threshold.
    </p>
  <% } else { %>
    <div class="table-responsive">
      <table class="table admin-table">
        <thead>
          <tr>
            <th scope="col">Product</th>
            <th scope="col">Option</th>
            <th scope="col">SKU</th>
            <th scope="col">Stock</th>
            <th scope="col">Threshold</th>
          </tr>
        </thead>

        <tbody>
          <% dashboard.lowStockItems.forEach((item) => { %>
            <tr>
              <td>
                <%= item.product_name %>

                <% if (item.is_demo) { %>
                  <span class="demo-label d-inline-block mt-2 mb-0">
                    Demo
                  </span>
                <% } %>
              </td>

              <td><%= item.flavour %></td>
              <td class="admin-sku"><%= item.sku %></td>

              <td>
                <span class="<%= item.quantity === 0 ? 'admin-stock-empty' : '' %>">
                  <%= item.quantity %>
                </span>
              </td>

              <td><%= item.threshold %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include("partials/footer") %>