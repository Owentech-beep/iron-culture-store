<%- include("partials/header") %>

<div class="admin-page-heading">
  <div>
    <p class="eyebrow">CATALOGUE MANAGEMENT</p>
    <h1 class="section-title mb-0">Products</h1>
  </div>

  <a href="/admin/products/new" class="btn btn-brand">
    Add Product
  </a>
</div>

<% if (notice) { %>
  <div class="notice-panel mb-3" role="status">
    <%= notice %>
  </div>
<% } %>

<div class="d-flex gap-2 mb-3">
  <a href="/admin/products" class="btn btn-outline-brand">
    Current Products
  </a>

  <a href="/admin/products?view=retired" class="btn btn-outline-brand">
    Retired Products
  </a>
</div>

<% if (retiredOnly) { %>
  <p class="text-muted-custom">
    These products are no longer for sale. Their records are retained
    for previous orders and payment reservations.
  </p>
<% } %>

<form action="/admin/products" method="GET" class="admin-search mb-4">
  <label for="productSearch" class="visually-hidden">Search products</label>

  <input
  type="hidden"
  name="view"
  value="<%= retiredOnly ? 'retired' : 'current' %>"
  >

   <label for="productSearch" class="visually-hidden">
    Search products
  </label>

  <button type="submit" class="btn btn-outline-brand">Search</button>
</form>

<p class="text-muted-custom"><%= total %> products</p>

<section class="admin-panel">
  <div class="table-responsive">
    <table class="table admin-table">
      <thead>
        <tr>
          <th>Product</th>
          <th>Brand</th>
          <th>Price</th>
          <th>Stock</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>

      <tbody>
        <% products.forEach((product) => { %>
          <tr>
            <td>
              <strong><%= product.name %></strong>

              <% if (product.is_demo) { %>
                <span class="demo-label d-inline-block mt-2 mb-0">
                  Demo
                </span>
              <% } %>
            </td>

            <td><%= product.brand_name %></td>

            <td>
              <%= formatMoney(product.sale_price ?? product.price) %>
            </td>

            <td><%= product.stock %></td>

            <td>
              <%= product.retired_at
                ? "Retired"
                : product.is_active
                  ? "Published"
                  : "Draft / Unpublished" %>
            </td>

            <td>
              <% if (!product.retired_at) { %>
                <a
                  href="/admin/products/<%= product.id %>/edit"
                  class="btn btn-outline-brand"
                >
                  Edit
                </a>

                <%- include("partials/delete-record", {
                  deleteKind: "products",
                  deleteEntry: product
                }) %>
              <% } else { %>
                <span class="text-muted-custom">History preserved</span>
              <% } %>
            </td>
          </tr>
        <% }); %>

        <% if (products.length === 0) { %>
          <tr>
            <td colspan="6">No products match your search.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<nav class="shop-pagination" aria-label="Product pages">
  <% if (page > 1) { %>
    <a
      class="btn btn-outline-brand"
      href="/admin/products?q=<%= encodeURIComponent(search) %>&page=<%= page - 1 %>"
      view=<%= retiredOnly ? 'retired' : 'current' %>&
    >
      Previous
    </a>
  <% } %>

  <span>Page <%= page %> of <%= totalPages %></span>

  <% if (page < totalPages) { %>
    <a
      class="btn btn-outline-brand"
      href="/admin/products?q=<%= encodeURIComponent(search) %>&page=<%= page + 1 %>"
      view=<%= retiredOnly ? 'retired' : 'current' %>&
    >
      Next
    </a>
  <% } %>
</nav>

<%- include("partials/footer") %>