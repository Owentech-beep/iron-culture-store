<%- include("partials/header") %>

<div class="admin-page-heading">
  <div>
    <p class="eyebrow">HOMEPAGE CONTENT</p>
    <h1 class="section-title">Homepage Slides</h1>
  </div>
</div>

<section class="admin-panel p-4 mb-4">
  <h2 class="h5">Upload a Slide</h2>

  <p class="text-muted-custom">
    Images: JPEG, PNG or WebP, up to 5 MB.
    Videos: MP4, up to 20 MB and 60 seconds.
    New uploads stay hidden until you publish them.
  </p>

  <p class="text-muted-custom">
    Only upload media you have permission to publish, including
    permission from customers shown in videos.
    Include important spoken information in the caption.
  </p>

  <form
    id="homeSlideUpload"
    action="/admin/slides/upload"
    method="POST"
    enctype="multipart/form-data"
    data-csrf="<%= csrfToken %>"
  >
    <label for="slideMedia" class="form-label">Image or video</label>

    <input
      id="slideMedia"
      name="media"
      type="file"
      accept="image/jpeg,image/png,image/webp,video/mp4"
      class="form-control mb-3"
      required
    >

    <button type="submit" class="btn btn-brand" disabled>
      Upload Slide
    </button>

    <p class="mt-3 mb-0" role="status" aria-live="polite"></p>
  </form>

  <noscript>
    <p>Enable JavaScript to upload slideshow media.</p>
  </noscript>
</section>

<% if (slides.length === 0) { %>
  <p>No slides yet. Upload your first image or video above.</p>
<% } %>

<% slides.forEach((slide) => { %>
  <section class="admin-panel p-4 mb-4">
    <p class="eyebrow">
      <%= slide.is_active ? "PUBLISHED" : "HIDDEN" %>
    </p>

    <% if (slide.media_type === "video") { %>
      <video
        src="<%= slide.media_url %>"
        controls
        playsinline
        preload="metadata"
        class="slide-admin-preview"
        aria-label="<%= slide.title %>"
      ></video>
    <% } else { %>
      <img
        src="<%= slide.media_url %>"
        alt="<%= slide.title %>"
        class="slide-admin-preview"
        loading="lazy"
      >
    <% } %>

    <form
      action="/admin/slides/<%= slide.id %>/save"
      method="POST"
      class="mt-3"
    >
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <label for="slide-title-<%= slide.id %>" class="form-label">
        Title / image description
      </label>

      <input
        id="slide-title-<%= slide.id %>"
        name="title"
        class="form-control mb-3"
        maxlength="120"
        value="<%= slide.title %>"
        required
      >

      <label for="slide-caption-<%= slide.id %>" class="form-label">
        Caption
      </label>

      <textarea
        id="slide-caption-<%= slide.id %>"
        name="caption"
        class="form-control mb-3"
        rows="3"
        maxlength="500"
      ><%= slide.caption %></textarea>

      <label for="slide-position-<%= slide.id %>" class="form-label">
        Display order — lower numbers appear first
      </label>

      <input
        id="slide-position-<%= slide.id %>"
        name="position"
        type="number"
        min="0"
        max="9999"
        step="1"
        class="form-control mb-3"
        value="<%= slide.position %>"
        required
      >

      <div class="form-check mb-3">
        <input
          id="slide-active-<%= slide.id %>"
          name="is_active"
          type="checkbox"
          class="form-check-input"
          <%= slide.is_active ? "checked" : "" %>
        >

        <label
          for="slide-active-<%= slide.id %>"
          class="form-check-label"
        >
          Published on homepage
        </label>
      </div>

      <button type="submit" class="btn btn-brand">Save Slide</button>
    </form>

    <details class="mt-4">
      <summary>Delete this slide</summary>

      <form
        action="/admin/slides/<%= slide.id %>/remove"
        method="POST"
        class="mt-3"
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <label for="slide-delete-<%= slide.id %>" class="form-label">
          Type DELETE to permanently remove this slide
        </label>

        <input
          id="slide-delete-<%= slide.id %>"
          name="confirmation"
          class="form-control mb-3"
          pattern="DELETE"
          autocomplete="off"
          required
        >

        <button type="submit" class="btn btn-outline-brand">
          Delete Slide
        </button>
      </form>
    </details>
  </section>
<% }); %>

<script src="/js/admin-slides.js?v=1" defer></script>

<%- include("partials/footer") %>