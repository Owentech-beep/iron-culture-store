<%- include("partials/head") %>
<%- include("partials/navbar") %>

<main id="main-content" class="section-space">
  <div class="container">
    <div class="auth-panel">
      <p class="eyebrow">YOUR ORDER</p>
      <h1 class="section-title">Payment Status</h1>

      <p class="order-number"><%= order.order_number %></p>

      <% if (order.is_demo) { %>
        <div class="demo-notice">
         Development test order. Sandbox payments do not collect real money.
        </div>
      <% } %>

      <dl class="cart-summary-lines">
        <div>
          <dt>Order status</dt>
          <dd><%= order.status %></dd>
        </div>

        <div>
          <dt>Payment status</dt>
          <dd><%= order.payment_status %></dd>
        </div>

        <div>
          <dt>Order total</dt>
          <dd>
            <%= order.total_cents === null
              ? "Awaiting delivery quote"
              : formatMoney(order.total_cents) %>
          </dd>
        </div>
      </dl>

      <% if (reasons.length > 0) { %>
        <div class="notice-panel mb-4">
          <h2 class="h6">Payment is unavailable</h2>

          <ul class="mb-0 ps-3">
            <% reasons.forEach((reason) => { %>
              <li class="mb-2"><%= reason %></li>
            <% }); %>
          </ul>
        </div>
      <% } %>

     <% if (paymentAttempt) { %>
        <div class="notice-panel mb-3">
          <p class="mb-1">
            Payment attempt:
            <strong><%= paymentAttempt.status %></strong>
          </p>

          <% if (paymentAttempt.has_reservation) { %>
            <p class="mb-0">
              Stock is reserved while this payment attempt is resolved.
            </p>
          <% } %>
        </div>
      <% } %>

      <% if (canStartSandbox) { %>
        <div class="demo-notice">
          Sandbox testing only. No real money will be collected.
        </div>

        <form
          action="/orders/<%= order.id %>/payment/sandbox"
          method="POST"
          class="mb-3"
        >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <button type="submit" class="btn btn-brand w-100">
            Start Sandbox Payment
          </button>
        </form>
      <% } %>

      <a
        href="/orders/<%= order.id %>/payment"
        class="btn btn-outline-brand w-100 mb-3"
      >
        Refresh Payment Status
      </a>

      <a
        href="/orders/<%= order.id %>"
        class="btn btn-outline-brand w-100"
      >
        Back to Order
      </a>
    </div>
  </div>
</main>

<%- include("partials/footer") %>
<%- include("partials/scripts") %>